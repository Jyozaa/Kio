{
  "name": "Kio — your Mac assistant",
  "short_name": "Kio",
  "description": "Send requests to your paired Mac and get results back.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#f5f4f0",
  "theme_color": "#f5f4f0",
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "files", "accept": ["image/*", "application/pdf", "text/*", ".csv", ".tsv", ".json"] }]
    }
  },
  "icons": [
    { "src": "/kio-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/kio-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ]
}
